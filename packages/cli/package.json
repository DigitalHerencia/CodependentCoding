{
  "name": "hipster-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Hipster Stack CLI: composes apps from the Maximal Template (local, unpublished).",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts"
