{
  "name": "hipster-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Hipster Stack command-line interface to the generator and Loaded Vibes editing tools.",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts"
  },
  "exports": {
    "./compose": "./src/compose.ts",
    "./slice": "./src/slice.ts",
    "./fields": "./src/fields.ts",
    "./exec": "./src/exec.ts",
    "./setup": "./src/setup.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "hipster-stack": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "gradient-string": "3.0.0",
    "@codependent/generator": "workspace:*",
    "@codependent/loaded-vibes": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.23.4"
  }
}
