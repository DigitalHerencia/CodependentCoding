{
  "name": "hipster-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Hipster Stack CLI: composes apps from the Maximal Template (local, unpublished).",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts"
  },
  "exports": {
    "./compose": "./src/compose/composeApp.ts",
    "./slice": "./src/slice/sliceApp.ts",
    "./fields": "./src/slice/fields.ts",
    "./exec": "./src/setup/exec.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "hipster-stack": "./dist/cli.mjs"
  },
  "files": [
    "assets",
    "dist",
    "templates"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "gradient-string": "3.0.0"
  },
  "devDependencies": {
    "tsdown": "0.23.2"
  }
}
