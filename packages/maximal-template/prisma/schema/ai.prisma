enum AiGenerationStatus {
  /// Historical only: new synchronous inference starts directly in RUNNING.
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Historical only: no cancellation mutation is supported.
  CANCELED
}

model AiGeneration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String

  provider String
  model    String
  status   AiGenerationStatus @default(RUNNING)

  input       Json
  output      Json?
  requestHash String?
  errorCode   String?

  /// Null means the inference provider did not report a measurement.
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal? @db.Decimal(19, 8)
  /// Zero marks historical values whose provider measurement provenance is unknown.
  measurementVersion Int @default(0)

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation("AiGenerationUser", fields: [userId], references: [id], onDelete: Restrict)
  usage        AiUsageLedger?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, requestHash])
}

model AiUsageLedger {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String
  generationId   String @unique @db.Uuid

  provider     String
  model        String
  /// Ledger measurements are append-only; unavailable values are never estimated.
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal? @db.Decimal(19, 8)
  /// New writes explicitly use version 1; existing amounts are retained without reinterpretation.
  measurementVersion Int @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("AiUsageUser", fields: [userId], references: [id], onDelete: Restrict)
  generation   AiGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
  @@index([organizationId, userId, occurredAt])
}
