{
  "name": "maximal-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "next start",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "governance:validate": "node scripts/validate.mjs",
    "governance:render": "node scripts/render-issue.mjs",
    "governance:taxonomy": "node scripts/sync-taxonomy.mjs",
    "governance:project": "node scripts/create-project.mjs",
    "governance:publish": "node scripts/publish-issues.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
