{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codependentcoding:governance:spec:v1.1",
  "title": "Engineering work specification (ticket)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "work_code",
    "team",
    "title",
    "issue_type",
    "cadence",
    "traceability",
    "documentation",
    "contracts",
    "ticket",
    "specification",
    "sub_issues",
    "bug_details",
    "github",
    "state",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "spec"
    },
    "id": {
      "type": "string",
      "pattern": "^M[123]-P[123]\\.[123]-[A-Z]+-T0[1-5]$"
    },
    "work_code": {
      "type": "string",
      "pattern": "^ENG-M[123]-P[123]\\.[123]-[A-Z]+-T0[1-5]$"
    },
    "team": {
      "const": "engineering"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issue_type": {
      "enum": ["feature", "bug"]
    },
    "cadence": {
      "enum": ["once", "repeatable", "expandable", "gate"],
      "description": "once: done one time. repeatable: runs again as needed. expandable: one sub-issue per item. gate: sign-off. Only repeatable and expandable specs may have sub_issues."
    },
    "traceability": {
      "type": "object",
      "required": [
        "milestone_id",
        "milestone_title",
        "phase_id",
        "phase_title",
        "dev_cycle_id",
        "dev_cycle_title",
        "task_id",
        "ontology_ids"
      ],
      "properties": {
        "milestone_id": {
          "type": "string"
        },
        "milestone_title": {
          "type": "string"
        },
        "phase_id": {
          "type": "string"
        },
        "phase_title": {
          "type": "string"
        },
        "dev_cycle_id": {
          "type": "string"
        },
        "dev_cycle_title": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "ontology_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "description": "Doc sections that feed this spec.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "section"],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^context/docs/[A-Za-z-]+\\.md$"
          },
          "section": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["application", "validation", "design"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "ticket": {
      "type": "object",
      "required": [
        "owner_role",
        "workday_limit",
        "estimated_hours",
        "time_log",
        "billable"
      ]
    },
    "specification": {
      "type": "object",
      "required": [
        "objective",
        "scope",
        "requirements",
        "inputs",
        "deliverables",
        "dependencies",
        "acceptance_criteria",
        "validation",
        "references"
      ]
    },
    "sub_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ENG-M[123]-P[123]\\.[123]-[A-Z]+-T0[1-5]\\.[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "issue_number": {
            "type": ["integer", "null"]
          },
          "issue_url": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "bug_details": {
      "type": ["object", "null"]
    },
    "github": {
      "type": "object",
      "required": [
        "title",
        "labels",
        "milestone",
        "issue_number",
        "issue_url",
        "project_item_id"
      ]
    },
    "state": {
      "type": "object",
      "required": ["status", "approval_required", "approved", "evidence"]
    },
    "source": {
      "type": "object"
    }
  }
}
