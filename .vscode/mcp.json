{
  "servers": {
    "sequentialthinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"],
      "gallery": true
    },

    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@latest"],
      "gallery": true
    },

    "prisma-postgres": {
      "type": "http",
      "url": "https://mcp.prisma.io/mcp",
      "gallery": true
    },

    "neondatabase/mcp-server-neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/sse",
      "headers": {
        "Authorization": "Bearer ${input:NEON_API_KEY}"
      },
      "gallery": true
    },

    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"],
      "gallery": true
    },

    "clerk": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@clerk/agent-toolkit",
        "-p",
        "local-mcp"
      ],
      "env": {
        "CLERK_API_KEY": "${input:CLERK_SECRET_KEY}"
      },
      "gallery": true
    },

    "microsoftdocs/mcp": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "version": "1.0.0",
      "gallery": true
    },

    "io.github.upstash/context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["@upstash/context7-mcp@1.0.25"],
      "env": {
        "CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
      },
      "gallery": true
    },

    "io.github.github/github-mcp-server": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v", "${workspaceFolder}:/workspace",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN=${input:GITHUB_TOKEN}",
        "ghcr.io/github/github-mcp-server:latest"
      ],
      "gallery": true
    },

    "microsoft/playwright-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "version": "0.0.1",
      "gallery": true
    }
  },

  "inputs": [
    {
      "id": "TIMEZONE",
      "type": "promptString",
      "description": "IANA timezone (e.g., America/Denver)",
      "password": false
    },
    {
      "id": "GITHUB_TOKEN",
      "type": "promptString",
      "description": "GitHub Personal Access Token",
      "password": true
    },
    {
      "id": "CLERK_SECRET_KEY",
      "type": "promptString",
      "description": "Clerk secret key",
      "password": true
    },
    {
      "id": "CONTEXT7_API_KEY",
      "type": "promptString",
      "description": "Context7 API key",
      "password": true
    },
    {
      "id": "NEON_API_KEY",
      "type": "promptString",
      "description": "Neon API key",
      "password": true
    }
  ]
}
