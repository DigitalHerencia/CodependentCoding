{
  "name": "maximal-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "check:modules": "node scripts/check-modules.mjs",
    "check:compose": "node scripts/check-compose.mjs",
    "check:env": "tsx --conditions=react-server scripts/check-env.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:schema-modules": "node scripts/check-schema-modules.mjs",
    "issues:sync": "node scripts/sync-issues.mjs",
    "db:init": "node scripts/db-init.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "next start",
    "doctrine:test": "node --test eslint/*.test.mjs",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm doctrine:test && pnpm typecheck && pnpm check:modules && pnpm check:ownership && pnpm check:env && pnpm test",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.20",
    "@hookform/resolvers": "5.9.2",
    "@huggingface/inference": "4.13.32",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sendgrid/eventwebhook": "8.0.0",
    "@sendgrid/mail": "8.1.6",
    "@tanstack/react-table": "9.3.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-resizable-panels": "4.14.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
