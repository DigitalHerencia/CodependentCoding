{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["owns"],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["domain", "addon"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$"
            }
          },
          "owns": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "packages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "env": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "required": {
                  "type": "boolean"
                },
                "scope": {
                  "type": "string",
                  "enum": ["server", "public"]
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["name", "required", "scope"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "kind", "label"],
        "additionalProperties": false
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        }
      }
    }
  },
  "required": ["base", "modules", "presets"],
  "additionalProperties": false
}
