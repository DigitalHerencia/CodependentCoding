{
  "name": "codependent-coding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codependent Coding software factory: the Maximal Template, the hipster-stack CLI, the Loaded Vibes Claude Code plugin and the landing page.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm doctrine:check && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "issues:sync": "node scripts/github/sync-issues.mjs",
    "plugin:doctrine": "node scripts/plugin-doctrine.mjs",
    "doctrine:check": "node scripts/doctrine-check.mjs",
    "cli": "tsx packages/cli/src/cli.ts",
    "cli:build": "pnpm --filter hipster-stack build",
    "cli:link": "pnpm cli:build && node scripts/cli-link.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "marked": "18.1.2",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/validate-npm-package-name": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "execa": "10.2.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
