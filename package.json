{
  "name": "codependent-coding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Codependent Coding web application, architecture documentation system, Anthimeria workbench, and Hipster Stack workspace.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:generated": "pnpm cli:build && vitest run tests/generated",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "issues:sync": "node scripts/github/sync-issues.mjs",
    "cli:dev": "tsx packages/cli/src/cli.ts",
    "cli:build": "tsdown"
  },
  "dependencies": {
    "@hipster-stack/core": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.6",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/validate-npm-package-name": "4.0.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "execa": "10.0.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
