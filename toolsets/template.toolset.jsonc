{
  // Template for a toolset definition. Copy this file and customize it per DevCycle.
  "tools": {
    "mcpServers": [
      "filesystem",
      "prisma-postgres",
      "neon",
      "clerk",
      "sequentialthinking",
      "memory",
      "github",
      "docs"
    ],
    "extensions": [
      "@types/node",
      "@tailwindcss/forms"
    ],
    "cli": [
      "node",
      "pnpm",
      "npx"
    ]
  },
  // Allowed operations specify which high‑level actions the agent may perform during this DevCycle
  "allowedOperations": [
    "readFiles",
    "writeFiles",
    "runCLI",
    "callMCP",
    "updateRepo",
    "updateIssues"
  ],
  // Denied operations restrict risky or out‑of‑scope actions
  "deniedOperations": [
    "deleteRepository",
    "exfiltrateSecrets"
  ]
}