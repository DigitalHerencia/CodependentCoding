{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "rangeStrategy": "replace",
  "reviewers": ["@LoadedVibes/framework-maintainers"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "labels": ["dependencies", "npm"],
      "schedule": ["before 3am on monday"]
    }
  ]
}
