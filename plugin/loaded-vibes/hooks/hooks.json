{
  "description": "Doctrine lint after every edit and the execution-state guard on Stop, in apps generated by hipster-stack only (hipster.json at the project root).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/when-app.mjs\" lint-edited-file.mjs",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/when-app.mjs\" execution-state-guard.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
