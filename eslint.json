{
  "$schema": "https://json.schemastore.org/eslintrc",
  "root": true,
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "ignorePatterns": ["lv_artifacts/src/**", "**/.loaded-vibes/**"],
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off"
  }
}
