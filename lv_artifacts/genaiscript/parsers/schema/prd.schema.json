{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Project PRD",
  "type": "object",
  "required": ["product", "goals", "features", "personas"],
  "properties": {
    "product": {
      "type": "object",
      "required": ["name", "description", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-FEAT-\\d+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "goals": { "type": "string" },
          "painPoints": { "type": "string" }
        }
      }
    },
    "dataModel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "fields"],
        "properties": {
          "entity": { "type": "string" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "default": { "type": "string" },
                "constraints": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "uxFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string" },
          "personas": { "type": "string" },
          "trigger": { "type": "string" },
          "steps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "alternativeFlows": { "type": "array", "items": { "type": "string" } },
          "errorHandling": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" } },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "authorization": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "roles": { "type": "array" },
            "permissions": { "type": "array" },
            "rules": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "services": { "type": "array" },
        "apis": { "type": "array" }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "budgets": { "type": "object" },
        "scalability": { "type": "array", "items": { "type": "string" } },
        "optimization": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "dataProtection": { "type": "array", "items": { "type": "string" } },
        "inputValidation": { "type": "array", "items": { "type": "string" } },
        "headers": { "type": "object" }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "logging": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "object" },
        "alerts": { "type": "object" }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
