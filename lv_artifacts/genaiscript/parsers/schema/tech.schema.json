{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Project Technical Requirements",
  "type": "object",
  "required": ["stack", "architecture", "database", "api", "testing", "devops"],
  "properties": {
    "stack": {
      "type": "object",
      "required": ["core", "tools"],
      "properties": {
        "core": {
          "type": "object",
          "required": ["framework", "language", "database", "auth"],
          "properties": {
            "framework": {
              "type": "object",
              "required": ["name", "version"],
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "language": {
              "type": "object",
              "required": ["name", "version"],
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "database": {
              "type": "object",
              "required": ["name", "version"],
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "orm": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "auth": {
              "type": "object",
              "required": ["name"],
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "styling": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
            },
            "hosting": { "type": "object", "properties": { "name": { "type": "string" } } }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "required": { "type": "boolean" },
              "provider": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["pattern", "structure"],
      "properties": {
        "pattern": { "type": "string" },
        "structure": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "database": {
      "type": "object",
      "required": ["strategy", "schema"],
      "properties": {
        "strategy": { "type": "string" },
        "schema": { "type": "object" },
        "migration": { "type": "object" },
        "seed": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "api": {
      "type": "object",
      "required": ["strategy", "endpoints"],
      "properties": {
        "strategy": { "type": "string" },
        "conventions": { "type": "object" },
        "endpoints": { "type": "array" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "authentication": { "type": "object" },
        "authorization": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "components": { "type": "object" },
        "state": { "type": "object" },
        "styling": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "testing": {
      "type": "object",
      "required": ["strategy", "types"],
      "properties": {
        "strategy": { "type": "string" },
        "types": { "type": "array" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "devops": {
      "type": "object",
      "required": ["environments", "cicd"],
      "properties": {
        "environments": { "type": "array" },
        "cicd": { "type": "object" },
        "envVars": { "type": "object" },
        "monitoring": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "optimization": { "type": "array" },
        "database": { "type": "array" },
        "caching": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "validation": { "type": "object" },
        "headers": { "type": "object" },
        "rateLimiting": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "production": { "type": "object" },
        "development": { "type": "object" },
        "constraints": { "type": "object" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
